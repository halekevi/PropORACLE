@startuml PropORACLE_Use_Case_Diagram
' UML use case diagram — PropORACLE
' Render: PlantUML extension, https://www.plantuml.com/plantuml, or: plantuml docs/diagrams/proporacle-use-cases.puml

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #1a1a2e
  BorderColor #d4af37
  FontColor #ffffff
}
skinparam rectangle {
  BackgroundColor #0d0d14
  BorderColor #7fc7d9
  FontColor #e8e8f0
}

title PropORACLE — UML Use Case Diagram

actor "Bettor /\nAnalyst" as Bettor
actor Operator as Operator
actor "Task\nScheduler" as Scheduler <<system>>
actor "PrizePicks\n(betting site)" as PPExt <<external>>

rectangle "PropORACLE" as System {

  package "Slate & research" as P_Slate {
    usecase "View home slate" as UC_Home
    usecase "Browse slate by sport" as UC_SportSlate
    usecase "View hot players &\nplayer consistency" as UC_Consistency
    usecase "View model performance" as UC_ModelPerf
    usecase "Export slate (Excel)" as UC_SlateExcel
  }

  package "Tickets" as P_Tickets {
    usecase "View built tickets\n(Goblin-70 + mixer)" as UC_TixLatest
    usecase "Browse tickets by date" as UC_TixDate
    usecase "View ticket EV &\nwin-rate summaries\n(MAIN only; YOLO excluded)" as UC_TixEV
    usecase "View ticket backtest" as UC_TixBacktest
  }

  package "Grades & evaluation" as P_Grades {
    usecase "Open grades hub" as UC_GradesHub
    usecase "Browse graded props" as UC_GradedProps
    usecase "Open slate evaluation\nreport" as UC_SlateEval
    usecase "Open ticket evaluation\nreport" as UC_TixEval
  }

  package "Income & tracking" as P_Income {
    usecase "View income / P&L\ndashboard (/income)" as UC_Income
    usecase "View grade history\n& sport breakdown" as UC_GradeHist
  }

  package "Payout tools" as P_Payout {
    usecase "Estimate payout\nmultiplier" as UC_PayEst
    usecase "View payout rate cards\n& combo table" as UC_PayRates
    usecase "Log payout observation" as UC_PayLog
    usecase "View payout ladder\n& examples" as UC_PayLadder
    usecase "Export payout logs" as UC_PayExport
  }

  package "Mobile app" as P_Mobile {
    usecase "Use live site\nin app shell (server.url)" as UC_MobRemote
    usecase "Use bundled offline UI\n(fallback only)" as UC_MobBundle
  }

  package "Account & UI" as P_UI {
    usecase "Manage account" as UC_Account
    usecase "Toggle theme\n(light/dark)" as UC_Theme
  }

  package "Pipeline & operations" as P_Ops {
    usecase "Check pipeline status" as UC_PipeStatus
    usecase "Run pipeline step\nfrom Home UI\n(local Flask only — verify)" as UC_RunUI
    usecase "Monitor pipeline job" as UC_MonitorJob
    usecase "Run daily pipeline" as UC_DailyRun
    usecase "Refresh / late fetch" as UC_Refresh
    usecase "Run sport pipeline\n(PowerShell)" as UC_SportRun
    usecase "Fetch PrizePicks slate\n(CDP-first, HTTP fallback)" as UC_FetchPP
    usecase "Enrich & rank props\n(steps 2–8)" as UC_Enrich
    usecase "Build combined tickets\n(mixer)" as UC_Combine
    usecase "Build Goblin-70 card\n(--write-web)" as UC_G70
    usecase "Capture live payouts\n(N-correct via CDP)" as UC_Payout
    usecase "Scrub published G70 legs\n(keep revalidation)" as UC_Scrub
    usecase "Grade completed slate" as UC_Grade
    usecase "Publish to origin/main" as UC_Publish
    usecase "Verify deploy / health" as UC_Health
  }
}

' --- Bettor ---
Bettor --> UC_Home
Bettor --> UC_SportSlate
Bettor --> UC_Consistency
Bettor --> UC_ModelPerf
Bettor --> UC_SlateExcel
Bettor --> UC_TixLatest
Bettor --> UC_TixDate
Bettor --> UC_TixEV
Bettor --> UC_TixBacktest
Bettor --> UC_GradesHub
Bettor --> UC_GradedProps
Bettor --> UC_SlateEval
Bettor --> UC_TixEval
Bettor --> UC_Income
Bettor --> UC_GradeHist
Bettor --> UC_PayEst
Bettor --> UC_PayRates
Bettor --> UC_PayLog
Bettor --> UC_PayLadder
Bettor --> UC_PayExport
Bettor --> UC_MobRemote
Bettor --> UC_Account
Bettor --> UC_Theme
Bettor --> PPExt : Places entries\n(outside system)

' --- Operator ---
Operator --> UC_PipeStatus
Operator --> UC_RunUI
Operator --> UC_DailyRun
Operator --> UC_Refresh
Operator --> UC_SportRun
Operator --> UC_Payout
Operator --> UC_Grade
Operator --> UC_Publish
Operator --> UC_Health
Operator --> UC_TixLatest
Operator --> UC_GradesHub
Operator --> UC_Income

' --- Scheduler ---
Scheduler --> UC_DailyRun
Scheduler --> UC_Refresh
Scheduler --> UC_Payout
Scheduler --> UC_Scrub
Scheduler --> UC_Grade

' --- Include / extend ---
UC_DailyRun ..> UC_SportRun : <<include>>
UC_Refresh ..> UC_SportRun : <<include>>
UC_SportRun ..> UC_FetchPP : <<include>>
UC_SportRun ..> UC_Enrich : <<include>>
UC_DailyRun ..> UC_Combine : <<include>>
UC_Refresh ..> UC_Combine : <<include>>
UC_Combine ..> UC_G70 : <<include>>
UC_G70 ..> UC_Publish : <<include>>
UC_Payout ..> UC_Publish : <<include>>
UC_Scrub ..> UC_Payout : <<extend>>\n(leg dropped → re-price)
UC_Grade ..> UC_Publish : <<include>>\n(git commit)
UC_RunUI ..> UC_MonitorJob : <<include>>
UC_MobBundle ..> UC_MobRemote : <<extend>>\n(offline)

note right of PPExt
  Real-money entries happen on PrizePicks;
  PropORACLE only supports research
  and ticket building.
end note

note bottom of System
  Web: Flask ui_runner — /, /tickets, /grades, /income, /payout, /account
  (/dashboard/income and /income.html → 302 /income)
  /tickets renders prebuilt JSON (Goblin-70 first, mixer under) — no rebuild
  Live JSON: origin/main ui_runner/templates/tickets_latest.json
  Mobile: Capacitor server.url = live site; bundled www/ fallback only; OTA off
  Batch: run_daily.ps1, refresh / late_fetch, run_grader.ps1,
         run_live_payout_capture.ps1, run_g70_keep_scrub.ps1, Publish-LiveSite.ps1
end note

@enduml
