@startuml PropORACLE_C4_Context
' C4 Level 1 — System Context
' Render: PlantUML + C4-PlantUML macros
' Online: https://www.plantuml.com/plantuml
' VS Code: PlantUML extension (jebbs.plantuml)

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()
skinparam shadowing false

title PropORACLE — C4 Level 1: System Context

Person(bettor,       "Bettor / Analyst",  "Reviews daily props, EV scores,\ntickets, grades, and P&L")
Person(operator,     "Operator",          "Runs pipelines, grades slates,\npublishes artifacts")

System(proporacle,   "PropORACLE",        "Multi-sport prop analytics.\nIngests boards + stats, scores edges\nwith XGBoost + rule-based keep gates,\nbuilds the Goblin-70 + mixer card.")

System_Ext(prizepicks,"PrizePicks",        "Board (projections) for step1;\nslip payouts for capture;\nreal-money entries (outside system)")
System_Ext(chrome,   "Chrome CDP :9222",  "Local debug browser used for\nin-page PrizePicks fetch + payout read")
System_Ext(stats,    "Stats sources",     "ESPN / boxscores / match logs,\nCFBD, nflverse")
System_Ext(lines,    "Line sources",      "Odds API (game lines),\nPinnacle (line movement)")
System_Ext(weather,  "Open-Meteo",        "Stadium weather (NFL / MLB)")
System_Ext(gemini,   "Gemini Vision",     "Payout screenshot import")
System_Ext(github,   "GitHub origin/main","Live tickets_latest.json,\ngraded props, eval HTML")
System_Ext(railway,  "Railway",           "Hosts Flask / Gunicorn\n(+ Volume for payout logs)")

Rel(bettor,     proporacle, "Views props, tickets,\ngrades, income",       "HTTPS")
Rel(operator,   proporacle, "Runs pipelines,\ngrades, publishes",         "PowerShell / HTTPS")
Rel(proporacle, chrome,     "CDP-first step1 +\nN-correct payout read",   "Chrome DevTools")
Rel(chrome,     prizepicks, "In-page fetch / slip view",                  "HTTPS")
Rel(proporacle, prizepicks, "HTTP fallback fetch\n(DataDome may block)",  "HTTPS / JSON")
Rel(proporacle, stats,      "Player + game stats",                        "HTTPS / JSON")
Rel(proporacle, lines,      "Game lines, line movement",                  "HTTPS / JSON")
Rel(proporacle, weather,    "Forecasts",                                  "HTTPS / JSON")
Rel(proporacle, gemini,     "Screenshot → payout rows",                   "HTTPS")
Rel(proporacle, github,     "Publish-LiveSite.ps1 /\ngrader commits",       "git push")
Rel(railway,    github,     "Reads live JSON",                            "HTTPS raw")
Rel(bettor,     prizepicks, "Places entries\n(external to system)",       "Web / App")

@enduml
