@startuml PropORACLE_C4_Components
' C4 Level 3 — Components (Flask API container)
' Render: PlantUML + C4-PlantUML macros
' Online: https://www.plantuml.com/plantuml
' VS Code: PlantUML extension (jebbs.plantuml)

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
skinparam shadowing false

title PropORACLE — C4 Level 3: Flask API Components

Container_Boundary(api, "Flask API  ·  Python / Gunicorn / Railway") {
  Component(route_home,    "Home route",    "Flask\n/  · /api/run",            "Slate UI, top edges,\npipeline status.\n/api/run: see note")
  Component(route_tickets, "Tickets route", "Flask\n/tickets  /api/tickets",   "Renders prebuilt dual card:\nGoblin-70 first, mixer under.\nSKIP groups hidden by default")
  Component(route_grades,  "Grades route",  "Flask\n/grades  /api/grades",     "Grades hub (latest date with\ncards), eval iframe, graded props")
  Component(route_income,  "Income route",  "Flask\n/income",                  "P&L dashboard; MAIN tracks only.\n/dashboard/income + /income.html\n→ 302 to /income")
  Component(route_payout,  "Payout route",  "Flask\n/payout",                  "Multiplier estimator, rate cards,\nlog, export (Railway Volume)")
  Component(route_account, "Account route", "Flask\n/account",                 "Account page")
}

ContainerDb(repo,  "origin/main live JSON", "GitHub", "tickets_latest.json, graded_props,\nticket_eval HTML, grade_history.json")
Container(g70,     "Ticket builders", "local", "Prebuild dual card;\nnot invoked at request time")
Container(teval,   "Grader / eval",   "local", "combined_ticket_grader.py (legs)\n+ build_ticket_eval.py (settlement)")
Container(webapp,  "Web App",         "Jinja2 + JS", "Renders HTML UI")
Container(mobile,  "Mobile App",      "Capacitor", "server.url → same routes")

Rel(webapp,        route_home,    "GET /",        "HTTP")
Rel(webapp,        route_tickets, "GET /tickets", "HTTP")
Rel(webapp,        route_grades,  "GET /grades",  "HTTP")
Rel(webapp,        route_income,  "GET /income",  "HTTP")
Rel(webapp,        route_payout,  "GET /payout",  "HTTP")
Rel(webapp,        route_account, "GET /account", "HTTP")
Rel(mobile,        webapp,        "Loads live site", "HTTPS")

Rel(route_tickets, repo, "reads prebuilt\ntickets_latest.json")
Rel(route_grades,  repo, "reads graded props\n+ eval HTML")
Rel(route_income,  repo, "reads grade_history.json")
Rel(g70,           repo, "published by\nPublish-LiveSite.ps1")
Rel(teval,         repo, "grader commits")

note as N1
  **Open (verify):**
  · /api/run + train_edge_model on Railway — the pipeline
    scores from local main_cp, so a pkl written on Railway
    never reaches step7. Label local-only or remove.
  · Income "rolling demo" rows — confirm they are excluded
    from the headline WR.
end note

@enduml
